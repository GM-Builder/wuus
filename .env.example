NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never add NEXT_PUBLIC_ to these names.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
WUUS_ADMIN_USER_IDS=owner-supabase-auth-user-uuid
# Generate a random secret of at least 32 characters; use a different one per environment.
WUUS_RATE_LIMIT_SECRET=
# Exact extra origins, comma separated. Add a verified preview URL; no wildcard.
WUUS_ALLOWED_ORIGINS=
